# === Step 2: Imports ===
import os
import gradio as gr
from langchain.document_loaders import PyPDFLoader, TextLoader
from langchain.embeddings import HuggingFaceEmbeddings
from langchain.vectorstores import FAISS
from langchain.text_splitter import CharacterTextSplitter
from langchain.chains import RetrievalQA
from langchain_huggingface import HuggingFaceEndpoint
from tempfile import NamedTemporaryFile
import requests
import traceback

# === Step 3: LLM & Embedding Setup ===
os.environ["HUGGINGFACEHUB_API_TOKEN"] = "your-hf-token-here"

llm = HuggingFaceEndpoint(
    repo_id="mistralai/Mixtral-8x7B-Instruct-v0.1",
    temperature=0.3,
    max_new_tokens=512,
)

embedding_model = HuggingFaceEmbeddings(model_name="sentence-transformers/all-MiniLM-L6-v2")

# === Step 4: Document Loader Function (PDF, TXT, URL) ===
def load_documents(file=None, url=None):
    docs = []
    try:
        if file:
            ext = file.name.split(".")[-1].lower()
            if ext == "pdf":
                loader = PyPDFLoader(file.name)
            else:
                loader = TextLoader(file.name)
            docs.extend(loader.load())
        elif url:
            response = requests.get(url)
            with NamedTemporaryFile(delete=False, suffix=".pdf") as tmp:
                tmp.write(response.content)
                tmp.flush()
                loader = PyPDFLoader(tmp.name)
                docs.extend(loader.load())
    except Exception as e:
        print("Error loading document:", e)
        traceback.print_exc()
    return docs

# === Step 5: Create QA Chain with Vector DB ===
def create_qa_chain(docs):
    splitter = CharacterTextSplitter(chunk_size=1000, chunk_overlap=150)
    texts = splitter.split_documents(docs)
    vectorstore = FAISS.from_documents(texts, embedding_model)
    return RetrievalQA.from_chain_type(llm=llm, retriever=vectorstore.as_retriever())

# === Step 6: Gradio Interface ===
qa_chain = None

def ingest(file, url):
    global qa_chain
    docs = load_documents(file, url)
    if docs:
        qa_chain = create_qa_chain(docs)
        return "Documents indexed. Ask underwriting or risk analysis questions."
    return "Document loading failed."

def ask_question(q):
    if qa_chain:
        return qa_chain.run(q)
    return "Please upload a document or enter a URL first."

with gr.Blocks() as demo:
    gr.Markdown("## CRE Debt and Equity Underwriting Assistant")
    with gr.Row():
        file_input = gr.File(label="Upload Investment Memo or Financials")
        url_input = gr.Textbox(label="Or Enter Document URL")
        ingest_btn = gr.Button("Ingest")
    status_box = gr.Textbox(label="Status")
    question_input = gr.Textbox(label="Ask a Question")
    answer_output = gr.Textbox(label="Answer")

    ingest_btn.click(fn=ingest, inputs=[file_input, url_input], outputs=status_box)
    question_input.submit(fn=ask_question, inputs=question_input, outputs=answer_output)

demo.launch()
