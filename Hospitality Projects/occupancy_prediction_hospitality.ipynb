   "source": [
    "# Occupancy Prediction Using Classification\n",
    "\n",
    "Train a classification model to predict whether a hotel will be at full occupancy."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "np.random.seed(42)\n",
    "data = pd.DataFrame({\n",
    "    'age': np.random.randint(20, 70, 500),\n",
    "    'visits_per_year': np.random.poisson(3, 500),\n",
    "    'avg_spend': np.random.normal(250, 50, 500)\n",
    "})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": 'from sklearn.ensemble import RandomForestClassifier\nX = data[[\'age\', \'visits_per_year\', \'avg_spend\']]\ny = np.random.choice([0, 1], len(X))  # 1 = full, 0 = not full\nmodel = RandomForestClassifier().fit(X, y)\nprint("Accuracy:", model.score(X, y))'
  }
 ],
