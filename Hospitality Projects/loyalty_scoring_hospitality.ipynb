   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "np.random.seed(42)\n",
    "data = pd.DataFrame({\n",
    "    'age': np.random.randint(20, 70, 500),\n",
    "    'visits_per_year': np.random.poisson(3, 500),\n",
    "    'avg_spend': np.random.normal(250, 50, 500)\n",
    "})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": 'from sklearn.linear_model import LogisticRegression\nX = data[[\'age\', \'visits_per_year\', \'avg_spend\']]\ny = np.where(data[\'visits_per_year\'] >= 4, 1, 0)\nmodel = LogisticRegression().fit(X, y)\nprint("Loyalty Model Accuracy:", model.score(X, y))'
  }
