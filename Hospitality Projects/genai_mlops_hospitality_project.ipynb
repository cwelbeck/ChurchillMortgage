   "source": [
    "# ML Model Operations & GenAI Integration Project for Hospitality (Hilton Grand Vacations Use Case)\n",
    "\n",
    "This notebook demonstrates a pipeline that combines traditional machine learning with GenAI to enhance vacation customer experience, featuring: model operations, feature factory, and GenAI integration for insight generation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic Setup\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, confusion_matrix\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Simulate Customer Booking Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data = pd.DataFrame({\n",
    "    'age': np.random.randint(25, 70, 1000),\n",
    "    'membership_years': np.random.randint(0, 10, 1000),\n",
    "    'vacation_budget': np.random.normal(4000, 1000, 1000),\n",
    "    'num_trips': np.random.poisson(2, 1000),\n",
    "    'responded_promo': np.random.binomial(1, 0.5, 1000),\n",
    "    'booked_vacation': np.random.binomial(1, 0.6, 1000)\n",
    "})\n",
    "data.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train/Test Split and Feature Engineering\n",
    "X = data.drop('booked_vacation', axis=1)\n",
    "y = data['booked_vacation']\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)\n",
    "model = RandomForestClassifier(n_estimators=100).fit(X_train, y_train)\n",
    "preds = model.predict(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluation\n",
    "print(classification_report(y_test, preds))\n",
    "sns.heatmap(confusion_matrix(y_test, preds), annot=True); plt.title('Confusion Matrix'); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
