   "source": [
    "# Project 9: Financial News Sentiment Analysis\n",
    "Analyze financial news headlines and articles to assess market sentiment using NLP techniques and transformers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install dependencies\n",
    "!pip install transformers datasets gradio pandas matplotlib"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Import libraries\n",
    "from transformers import pipeline\n",
    "import pandas as pd\n",
    "import gradio as gr\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Load sentiment analysis pipeline\n",
    "classifier = pipeline('sentiment-analysis', model='ProsusAI/finbert')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Define analysis function\n",
    "def analyze_sentiment(news_text):\n",
    "    results = classifier(news_text)\n",
    "    df = pd.DataFrame(results)\n",
    "    sentiment_counts = df['label'].value_counts().to_dict()\n",
    "    return df, sentiment_counts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Gradio UI\n",
    "def sentiment_interface(news_input):\n",
    "    df, counts = analyze_sentiment(news_input.split('\n'))\n",
    "    fig, ax = plt.subplots()\n",
    "    pd.Series(counts).plot(kind='bar', ax=ax, title='Sentiment Distribution')\n",
    "    ax.set_ylabel('Count')\n",
    "    fig.tight_layout()\n",
    "    return df, fig\n",
    "\n",
    "demo = gr.Interface(\n",
    "    fn=sentiment_interface,\n",
    "    inputs=gr.Textbox(label="Paste financial news headlines/articles", lines=10),\n",
    "    outputs=[gr.Dataframe(label="Sentiment Analysis Results"), gr.Plot(label="Sentiment Chart")],\n",
    "    title="Financial News Sentiment Analyzer",\n",
    "    description="This tool uses FinBERT to analyze sentiment in financial news."\n",
    ")\n",
    "demo.launch()"
   ]
  }
 ],
