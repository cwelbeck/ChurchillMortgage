   "source": [
    "# Generative AI for Pathology Report Summarization\n",
    "\n",
    "This notebook uses a pre-trained generative model to summarize pathology reports using Hugging Face Transformers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install transformers -q"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import pipeline\n",
    "import pandas as pd\n",
    "\n",
    "summarizer = pipeline('summarization', model='t5-small', tokenizer='t5-small')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "reports = [\n",
    "    "Biopsy indicates malignant neoplasm with abnormal mitotic figures and nuclear pleomorphism in the liver tissue.",\n",
    "    "Tissue sample is benign. No sign of cancerous growth or abnormal cellular activity is noted."\n",
    "]\n",
    "df = pd.DataFrame({'original_report': reports})\n",
    "df['summary'] = df['original_report'].apply(lambda x: summarizer('summarize: ' + x, max_length=50, min_length=15, do_sample=False)[0]['summary_text'])\n",
    "df"
   ]
  }
 ],
