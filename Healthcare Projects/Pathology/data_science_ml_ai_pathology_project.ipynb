 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Pathology Report Analysis: Data Science, Machine Learning, and AI Project\n",
    "\n",
    "This notebook demonstrates end-to-end pathology report analysis using data science, machine learning, and AI-based summarization."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import re, string\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import classification_report, confusion_matrix\n",
    "from wordcloud import WordCloud"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Sample Pathology Reports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.DataFrame({\n",
    "    'report': [\n",
    "        'Malignant neoplasm with necrosis observed in liver biopsy.',\n",
    "        'No cancerous growth. Benign cellular structure.',\n",
    "        'Carcinoma detected in epithelial cells.',\n",
    "        'Normal histology with no malignancy.'\n",
    "    ],\n",
    "    'label': [1, 0, 1, 0]\n",
    "})\n",
    "df['report'] = df['report'].str.lower()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Preprocessing and Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def clean_text(text):\n",
    "    text = re.sub(r'[%s]' % re.escape(string.punctuation), '', text)\n",
    "    text = re.sub(r'\d+', '', text)\n",
    "    return text.strip()\n",
    "\n",
    "df['clean'] = df['report'].apply(clean_text)\n",
    "wc = WordCloud(width=600, height=300).generate(' '.join(df['clean']))\n",
    "plt.imshow(wc); plt.axis('off'); plt.title('Word Cloud'); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ML Classification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X = TfidfVectorizer().fit_transform(df['clean'])\n",
    "y = df['label']\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)\n",
    "model = LogisticRegression().fit(X_train, y_train)\n",
    "preds = model.predict(X_test)\n",
    "print(classification_report(y_test, preds))\n",
    "sns.heatmap(confusion_matrix(y_test, preds), annot=True); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## AI: Report Summarization with T5"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install transformers -q\n",
    "from transformers import pipeline\n",
    "summarizer = pipeline('summarization', model='t5-small')\n",
    "df['summary'] = df['report'].apply(lambda x: summarizer('summarize: ' + x, max_length=50, min_length=10, do_sample=False)[0]['summary_text'])\n",
    "df[['report', 'summary']]"
   ]
  }
 ],
