 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Research Paper Q&A Chatbot with URL and Document Upload\n",
    "This notebook creates a Generative AI chatbot for answering questions about uploaded documents or documents linked via URLs using a Gradio interface."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install gradio langchain pypdf unstructured beautifulsoup4 requests tiktoken faiss-cpu openai"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import gradio as gr\n",
    "from langchain.document_loaders import UnstructuredURLLoader, PyPDFLoader, TextLoader\n",
    "from langchain.embeddings import OpenAIEmbeddings\n",
    "from langchain.vectorstores import FAISS\n",
    "from langchain.text_splitter import CharacterTextSplitter\n",
    "from langchain.chains import RetrievalQA\n",
    "from langchain.chat_models import ChatOpenAI\n",
    "from tempfile import NamedTemporaryFile\n",
    "import requests\n",
    "import os\n",
    "os.environ['OPENAI_API_KEY'] = 'your-api-key'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_documents(file_obj, url):\n",
    "    docs = []\n",
    "    if file_obj:\n",
    "        ext = file_obj.name.split('.')[-1]\n",
    "        if ext.lower() == 'pdf':\n",
    "            loader = PyPDFLoader(file_obj.name)\n",
    "            docs.extend(loader.load())\n",
    "        else:\n",
    "            loader = TextLoader(file_obj.name)\n",
    "            docs.extend(loader.load())\n",
    "    elif url:\n",
    "        loader = UnstructuredURLLoader(urls=[url])\n",
    "        docs.extend(loader.load())\n",
    "    return docs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_qa_chain(docs):\n",
    "    splitter = CharacterTextSplitter(chunk_size=1000, chunk_overlap=100)\n",
    "    texts = splitter.split_documents(docs)\n",
    "    embeddings = OpenAIEmbeddings()\n",
    "    vectorstore = FAISS.from_documents(texts, embeddings)\n",
    "    qa = RetrievalQA.from_chain_type(llm=ChatOpenAI(), retriever=vectorstore.as_retriever())\n",
    "    return qa"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "qa_chain = None\n",
    "
",
    "def ingest_and_prepare(file, url):\n",
    "    global qa_chain\n",
    "    docs = load_documents(file, url)\n",
    "    if docs:\n",
    "        qa_chain = create_qa_chain(docs)\n",
    "        return 'Document successfully loaded and indexed. Ask your question below.'\n",
    "    return 'Failed to load any documents.'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def ask_question(question):\n",
    "    if qa_chain:\n",
    "        return qa_chain.run(question)\n",
    "    return 'Please upload a document or provide a URL first.'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "with gr.Blocks() as demo:\n",
    "    gr.Markdown("""# Research Paper Q&A Chatbot\nUpload a document or enter a URL to a paper and ask questions about it.""")\n",
    "    with gr.Row():\n",
    "        file_input = gr.File(label="Upload Document")\n",
    "        url_input = gr.Textbox(label="Or Enter URL")\n",
    "        ingest_btn = gr.Button("Load Document")\n",
    "    status_output = gr.Textbox(label="Status")\n",
    "    question_input = gr.Textbox(label="Ask a question")\n",
    "    answer_output = gr.Textbox(label="Answer")\n",
    "    ingest_btn.click(fn=ingest_and_prepare, inputs=[file_input, url_input], outputs=status_output)\n",
    "    question_input.submit(fn=ask_question, inputs=question_input, outputs=answer_output)\n",
    "
",
    "demo.launch()"
   ]
  }
 ],
